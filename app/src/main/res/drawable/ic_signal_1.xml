<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="3dp"
        android:height="4dp"
        android:gravity="bottom|left">
        <shape>
            <solid android:color="@color/signal_on" />
        </shape>
    </item>
    <item
        android:width="3dp"
        android:height="7dp"
        android:gravity="bottom|left"
        android:left="4dp">
        <shape>
            <solid android:color="@color/signal_off" />
        </shape>
    </item>
    <item
        android:width="3dp"
        android:height="10dp"
        android:gravity="bottom|left"
        android:left="8dp">
        <shape>
            <solid android:color="@color/signal_off" />
        </shape>
    </item>
    <item
        android:width="3dp"
        android:height="13dp"
        android:gravity="bottom|left"
        android:left="12dp">
        <shape>
            <solid android:color="@color/signal_off" />
        </shape>
    </item>
</layer-list>
